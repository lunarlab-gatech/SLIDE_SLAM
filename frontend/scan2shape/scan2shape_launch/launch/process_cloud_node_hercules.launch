<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- Set important robot parameters-->
    <arg name="odom_topic" default="/odom"/>
    <arg name="robot_name" default="robot0"/>
    <arg name="camera_frame_wrt_odom_frame_T"/>
    <arg name="camera_frame_wrt_odom_frame_R_quat"/>
    <arg name="process_cloud_node_name" default="process_cloud_node"/>

    <param name="process_cloud_node_name" value="$(arg process_cloud_node_name)"/>
    <node pkg="scan2shape_launch" type="process_cloud_node_hercules.py" name="$(arg process_cloud_node_name)" output="screen" launch-prefix="taskset -c 0-2" ns="$(arg robot_name)">

        <remap from="/odom" to="$(arg odom_topic)"/>

        <param name="~cls_config_path" value="$(find object_modeller)/config/hercules_cls_config.yaml"/>
        <param name="~robot_name" value="$(arg robot_name)"/>
        <param name="~camera_frame_wrt_odom_frame_T" value="$(arg camera_frame_wrt_odom_frame_T)"/>
        <param name="~camera_frame_wrt_odom_frame_R_quat" value="$(arg camera_frame_wrt_odom_frame_R_quat)"/>

        <rosparam command="load" file="$(find scan2shape_launch)/config/process_cloud_node_indoor_params.yaml"/>
    </node>
</launch>